{
  "name": "freemyid-web",
  "private": true,
  "type": "module",
  "version": "3.0.0",
  "description": "Free My ID website v3 (Astro static output for GitHub Pages)",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens": "node scripts/gen-tokens.mjs",
    "dev": "node scripts/gen-tokens.mjs && astro dev",
    "build": "node scripts/gen-tokens.mjs && astro build && node scripts/tighten-csp.mjs dist",
    "check": "node scripts/check-site.mjs dist",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/react": "7.1.4",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "motion": "14.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "yaml": "2.9.1"
  }
}
