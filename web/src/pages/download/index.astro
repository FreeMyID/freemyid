---
// Download. Release details still come only from site_src/data/release.yaml.
// Keep the published release button and the no-release “opens soon” state unchanged.
import "@/styles/site-refresh.css";
import Base from "@/layouts/Base.astro";
import Crumbs from "@/components/Crumbs.astro";
import Icon from "@/components/Icon.astro";
import SmartScreen from "@/components/SmartScreen.astro";
import CopyHash from "@/components/CopyHash.astro";
import RefreshCallout from "@/components/site-refresh/RefreshCallout.astro";
import RefreshSection from "@/components/site-refresh/RefreshSection.astro";
import RefreshSteps from "@/components/site-refresh/RefreshSteps.astro";
import { pageProps, release, releaseDate, site, url } from "@/lib/site";

const p = pageProps("download");
const v = release.version;
---

<Base {...p}>
  <div class="site-refresh">
    <section class="site-refresh__section site-refresh__section--compact">
      <div class="site-refresh__wrap">
        <Crumbs crumbs={p.crumbs} />
        <div class="site-refresh__hero">
          <div class="site-refresh__hero-copy">
            <p class="site-refresh__eyebrow">For Windows 10 and Windows 11</p>
            <h1 class="site-refresh__hero-title" id="download-title">Download Free My ID</h1>
            <p class="site-refresh__hero-lead">Free, with no administrator password needed.</p>
            {v ? (
              <div class="site-refresh__hero-actions">
                {/* D5: keep the existing release asset URL and visible installer name. */}
                <a class="site-refresh__button" href={site.download_url}>
                  <Icon name="download" />Download FreeMyIDSetup.exe
                </a>
              </div>
            ) : (
              <RefreshCallout title="Download opens soon" tone="note">
                <p>Not published yet. We'll show the download button here the day the first version is ready.</p>
              </RefreshCallout>
            )}
            <p class="site-refresh__hero-note">
              {v
                ? <>A Mac app and phone versions aren't available yet.</>
                : <>Version number, size and checksum will show here when the first version is published. A Mac app and phone versions aren't available yet.</>}
              {" "}<a href={url("developers/")}>Using Linux or macOS? See the developer page.</a>
            </p>
          </div>

          <aside class="site-refresh__card" aria-labelledby="download-details-title">
            <h2 class="site-refresh__card-title" id="download-details-title">Download details</h2>
            <dl class="grid grid-cols-[auto_1fr] gap-x-m gap-y-2xs">
              {/* WR-26: “works on” only once a release exists. */}
              <dt class="font-bold text-heading">{v ? "Works on" : "Made for"}</dt><dd>Windows 10 and 11</dd>
              <dt class="font-bold text-heading">Price</dt><dd>Free</dd>
              {v && <><dt class="font-bold text-heading">Version</dt><dd>{v}{releaseDate && ` (${releaseDate})`}</dd></>}
              {release.size_mb && <><dt class="font-bold text-heading">Size</dt><dd>{release.size_mb} MB</dd></>}
            </dl>
            {v && <p class="mt-s">Works on 64-bit Windows 10 and 11, including newer Windows 11 laptops with ARM chips.</p>}
          </aside>
        </div>
      </div>
    </section>

    <div id="smartscreen">
      <RefreshSection
        title="Windows may show a blue warning. Here's why, and what to do"
        titleId="smartscreen-title"
        lead="Windows shows this warning for new programs that haven't paid for a publisher certificate yet. Free My ID is free and hasn't bought one yet. The warning doesn't mean anything is wrong."
        tone="alt"
      >
      <p class="site-refresh__prose">
        Not sure about this step? Ask a family member to sit with you. <a href={url("families/")}>Here's a one-page guide for them.</a>
      </p>
      <RefreshSteps ariaLabel="Steps to open the Free My ID installer" class="mt-l min-[56.25em]:grid-cols-2">
        <li class="site-refresh__step">
          <span class="site-refresh__step-number" aria-hidden="true">1</span>
          <h3 class="site-refresh__step-title">Open the file you downloaded</h3>
          <p>It's called <strong>FreeMyIDSetup.exe</strong>. You'll usually find it in your <strong>Downloads</strong> folder, or at the bottom or top-right of your web browser.</p>
        </li>
        <li class="site-refresh__step">
          <span class="site-refresh__step-number" aria-hidden="true">2</span>
          <h3 class="site-refresh__step-title">Click the small words “More info”</h3>
          <p>If a blue box says <strong>“Windows protected your PC”</strong>, don't click “Don't run”. Click <strong>More info</strong> instead.</p>
          <SmartScreen step={1} />
        </li>
        <li class="site-refresh__step">
          <span class="site-refresh__step-number" aria-hidden="true">3</span>
          <h3 class="site-refresh__step-title">Check the name, then click “Run anyway”</h3>
          <p>Make sure it says the app is <strong>FreeMyIDSetup.exe</strong>. It will say “Unknown publisher”; that's expected. Then click <strong>Run anyway</strong>.</p>
          <RefreshCallout title="Only run the file from this page" tone="note">
            <p>Only do this if you downloaded the file from this page. If it came from anywhere else, delete it.</p>
          </RefreshCallout>
          <SmartScreen step={2} />
        </li>
        <li class="site-refresh__step">
          <span class="site-refresh__step-number" aria-hidden="true">4</span>
          <h3 class="site-refresh__step-title">Click Install</h3>
          <p>Free My ID opens by itself and walks you through six simple screens.</p>
        </li>
      </RefreshSteps>
      </RefreshSection>
    </div>

    <RefreshSection title="How to know it's really us" titleId="genuine-title" width="narrow">
      <RefreshCallout title="Stay safe" tone="note">
        <p>Only download Free My ID from this page. We will never email you an installer, and we will never call you.</p>
      </RefreshCallout>

      <details id="checksum" class="site-refresh__faq mt-m">
        <summary>For helpers: check the download is genuine</summary>
        <div class="site-refresh__faq-answer site-refresh__prose">
          {/* source: .github/workflows/build.yml (sha256sum > SHA256SUMS.txt, attached to the release); Get-FileHash defaults to SHA256 */}
          <p>{v ? <>Each release lists a <strong>SHA256SUMS.txt</strong> file.</> : <>Each release will come with a <strong>SHA256SUMS.txt</strong> file (no version is published yet).</>} In PowerShell, run <code>Get-FileHash .\FreeMyIDSetup.exe</code> and check that the long code matches the line for FreeMyIDSetup.exe in that file.</p>
          {release.sha256 && (
            <>
              <p>For version {v}, the code is: <code class="block break-all rounded-md bg-surface p-xs text-text">{release.sha256}</code></p>
              <CopyHash value={release.sha256} />
            </>
          )}
        </div>
      </details>

      {v && (
        <>
          {/* Owner rule: release notes live on this site. Values come from release.yaml. */}
          <h2 class="mt-xl" id="release-notes">Release notes</h2>
          <dl class="mt-s grid grid-cols-[auto_1fr] gap-x-m gap-y-2xs">
            <dt class="font-bold text-heading">Version</dt><dd>{v}{String(v).startsWith("0.") && " (an early release)"}</dd>
            {releaseDate && <><dt class="font-bold text-heading">Published</dt><dd>{releaseDate}</dd></>}
            {release.size_mb && <><dt class="font-bold text-heading">Size</dt><dd>{release.size_mb} MB</dd></>}
            {release.sha256 && <><dt class="font-bold text-heading">Fingerprint</dt><dd><a href="#checksum">SHA256 code, under “For helpers” above</a></dd></>}
          </dl>
          {release.notes?.length ? (
            <ul class="mt-s list-disc ps-l">{release.notes.map((n) => <li>{n}</li>)}</ul>
          ) : null}
        </>
      )}

      <h2 class="mt-xl" id="remove">Removing it</h2>
      {/* source: freemyid.iss UninstallDisplayName, [UninstallRun] schedule removal, and delete-data prompt */}
      <p class="mt-s site-refresh__prose">Open Windows <strong>Settings → Apps</strong>, find <strong>Free My ID</strong>, and click <strong>Uninstall</strong>. It asks whether to delete your saved records too.</p>
    </RefreshSection>
  </div>
</Base>
