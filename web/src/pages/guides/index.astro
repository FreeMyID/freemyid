---
// Guides index. Same copy and source comments as site_src/templates/pages/guides.html.
// Guides are built from brokers/registry.sample.yaml (public sample only).
import Base from "@/layouts/Base.astro";
import PageHead from "@/components/PageHead.astro";
import Section from "@/components/Section.astro";
import Icon from "@/components/Icon.astro";
import Card from "@/components/ui/Card.astro";
import Alert from "@/components/ui/Alert.astro";
import Badge from "@/components/ui/Badge.astro";
import Disclosure from "@/components/ui/Disclosure.astro";
import CtaDownload from "@/components/CtaDownload.astro";
import { GROUPS, guides, guidesMeta, pageProps, url } from "@/lib/site";
const p = pageProps("guides");
// Idea 4 (docs/marketing/COMPETITOR_SITE_REVIEW.md): every guide, A to Z, from the same build data as the cards below.
const az = [...guides].sort((a, b) => a.name.localeCompare(b.name, "en", { sensitivity: "base" }));
---
<Base {...p}>
<PageHead crumbs={p.crumbs} title="Free opt-out guides"
  lead="Step-by-step guides to ask people-search sites to remove your listing. They're free, and you don't need Free My ID to use them." />
{/* source: guides built from brokers/registry.sample.yaml; no app needed (they are plain web pages) */}
<Section label="Before you start" tight>
  {/* Idea 9: define the term once. Wording reused from families (definition) and the guide template (how listings are built). */}
  <Disclosure summary="What is a people-search site?" id="what-is-people-search" class="mb-m max-w-[48rem]">
    <p>Websites that publish names, addresses and phone numbers, also called data brokers. Sites like this build listings from public records and purchased data, often with your address, age, phone number and relatives.</p>
  </Disclosure>
  <div class="grid gap-m min-[56em]:grid-cols-[3fr_2fr]">
    <Alert class="my-0">
      <h2 class="text-h3">Before you start</h2>
      {/* source: PLAN_V1 D2 / USER_GUIDE section 2 (separate removal mailbox); shared rule 6 + POSITIONING rule 4 (never pay, never SSN); registry recheck_interval_days (relisting) */}
      <ul>
        <li>Make a separate email address just for removals. Sites send confirmation links to it, and you won't mind if it gets spam.</li>
        <li>You should never have to pay to be removed. If a people-search site asks for money or your Social Security number, stop.</li>
        <li>Sites often list people again later. Check back every few months.</li>
      </ul>
    </Alert>
    {/* WR-61, WR-62, WR-63: topic guides */}
    <ul class="grid content-start gap-s" role="list">
      <Card as="li" class="gap-2xs">
        <span class="flex items-center gap-xs font-bold text-heading"><Icon name="family" class="size-6 text-brand" />Helping a parent or grandparent?</span>
        <p>Start with <a href={url("guides/help-a-parent-remove-their-information/")}>how to help a parent get their details off people-search sites</a>.</p>
      </Card>
      <Card as="li" class="gap-2xs">
        <span class="flex items-center gap-xs font-bold text-heading"><Icon name="phone" class="size-6 text-brand" />Worried about your phone number?</span>
        <p>Read <a href={url("guides/get-your-phone-number-off-people-search-sites/")}>how to get your phone number off people-search sites</a>.</p>
      </Card>
    </ul>
  </div>
</Section>
<div class="wrap pb-l">
  {/* Idea 4: generated from `guides` (brokers/registry.sample.yaml); dates are each entry's last_verified, shown only when verified. */}
  <Disclosure summary="See every site we cover, A to Z" id="a-to-z" class="max-w-[48rem]">
    <ul class="grid list-none gap-3xs ps-0 min-[40em]:grid-cols-2" role="list">
      {az.map((g) => (
        <li class="mt-0">
          <a class="inline-flex min-h-tap items-center" href={url(g.out)}>{g.name}</a>
          {g.covered_by
            ? <span class="block text-small text-muted">Covered by the {g.covered_by.name} removal</span>
            : g.verified && <span class="block text-small text-muted">Steps checked {g.last_verified}</span>}
        </li>
      ))}
    </ul>
  </Disclosure>
</div>
{GROUPS.map(([key, label], gi) => {
  const items = guides.filter((g) => g.group === key);
  return items.length > 0 && (
    <section class:list={["py-xl", gi % 2 === 0 && "bg-bg-alt"]} aria-labelledby={`g-${key}`}>
      <div class="wrap">
        <h2 id={`g-${key}`}>{label}</h2>
        <ul class="mt-m grid gap-s [grid-template-columns:repeat(auto-fill,minmax(min(100%,17rem),1fr))]" role="list">
          {items.map((g) => (
            <li>
              <a class="group flex h-full min-h-tap flex-col gap-2xs rounded-xl border border-line bg-card p-m no-underline shadow-1 transition-shadow duration-200 hover:border-line-strong hover:shadow-2 motion-reduce:transition-none" href={url(g.out)}>
                <span class="flex items-center justify-between gap-xs text-lead font-bold text-link underline underline-offset-[0.18em]">{g.name}<Icon name="arrow-right" class="shrink-0 text-brand" /></span>
                {g.covered_by
                  ? <span class="text-small text-muted">Covered by the {g.covered_by.name} removal</span>
                  : g.verified
                    ? <Badge variant="ok" class="w-fit"><Icon name="check" />Steps checked {g.last_verified}</Badge>
                    : <span class="text-small text-muted">Steps from our research</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  );
})}
<Section tone="brand" title="Rather not do it all by hand?" titleId="let-us">
  {/* source: PLAN_V1 D1 (three tiers) and D4 (daily checks, re-scan); runs locally (netpolicy.py) */}
  <p class="max-w-measure text-lead">Free My ID does the repetitive part for you on your own computer, keeps track of every site, and checks again later.</p>
  <div class="mt-m"><CtaDownload look="onBrand" /></div>
</Section>
<div class="wrap py-l">
  {/* source: /brokers/ (brokers/coverage.public.yaml) */}
  <p class="max-w-measure">Don't see a site here? These guides cover the best-known sites. The <a href={url("brokers/")}>full list of sites we cover</a> shows every site on our list and how it is handled.</p>
  <p class="mt-s max-w-measure text-small text-muted">Guide data: the Free My ID sample broker registry, version {guidesMeta.version}, licensed <a href="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</a>. Sites change their pages often; if a guide is out of date, follow what the site's own page says.</p>
</div>
</Base>
