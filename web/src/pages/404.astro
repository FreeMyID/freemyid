---
// 404. Astro links are absolute under the base path, so this page works at any depth on Pages.
// source: no factual claim; reassurance per docs/POSITIONING.md rule 3 (no fear selling).
import Base from "@/layouts/Base.astro";
import { buttonVariants } from "@/components/ui/button-variants";
import { pages, url } from "@/lib/site";
import Icon from "@/components/Icon.astro";
import Spotlight from "@/components/aceternity/Spotlight.astro";
const p = pages["404"];
---
<Base title={p.title} description={p.description} out={p.out} noindex>
  {/* Revamp (lead): the quiet Spotlight backdrop, content in one calm card. */}
  <Spotlight as="div" tone="quiet" pattern="grid" edge={false} class="py-3xl">
  <div class="wrap-narrow"><div class="rounded-xl border border-line bg-card p-m shadow-2 sm:p-l">
    <Icon name="search" class="size-10 text-brand" />
    <h1 class="mt-s">We couldn't find that page</h1>
    <p class="mt-s text-lead text-muted">The link may be old or mistyped. Nothing is wrong with your computer.</p>
    <div class="mt-l flex flex-wrap gap-s">
      <a class={buttonVariants({ size: "lg" })} href={url("")}>Go to the home page</a>
      <a class={buttonVariants({ variant: "secondary", size: "lg" })} href={url("guides/")}>See the opt-out guides</a>
    </div>
  </div></div>
  </Spotlight>
</Base>
