---
// Home, v3. Keep D10's order and approved copy. All refreshed styles are page-scoped
// through the temporary site-refresh layer; Base, Header and Footer remain unchanged.
import "@/styles/site-refresh.css";
import Base from "@/layouts/Base.astro";
import CtaDownload from "@/components/CtaDownload.astro";
import Icon from "@/components/Icon.astro";
import Art from "@/components/Art.astro";
import FaqList from "@/components/FaqList.astro";
import RefreshSection from "@/components/site-refresh/RefreshSection.astro";
import RefreshCard from "@/components/site-refresh/RefreshCard.astro";
import RefreshSteps from "@/components/site-refresh/RefreshSteps.astro";
import RefreshCallout from "@/components/site-refresh/RefreshCallout.astro";
import homeScreenshot from "@/art/screenshots/home-hero-v0.2.0.png";
import { faq, guides, pageProps, release, site, url } from "@/lib/site";

const version = release.version;
const homeFaq = faq.filter((question) => question.home);
const examples = [
  {
    art: "sections/step-who",
    title: "Tell it who to protect.",
    copy: "Six short screens: your name and the towns you have lived in. It never asks for your Social Security number or bank or card details, and never charges you.",
  },
  {
    art: "sections/step-send",
    title: "It sends the requests.",
    copy: "By email, by walking you through a site's form, or by filling the form in while you watch. Each site gets only what it already shows about you.",
  },
  {
    art: "sections/step-report",
    title: "It keeps checking.",
    copy: "Once a day, quietly in the background, while your computer is on and you are signed in. You see who confirmed, who is still waiting, and it asks again if a site lists you again.",
  },
];
const comparisonRows: [string, string[], string[], string[]][] = [
  ["Price", ["Free", "yes"], ["Yearly or monthly fee"], ["Free, your time"]],
  ["Where your details go", ["Only to the sites you ask to remove you", "yes"], ["Sent to the company"], ["Only to the sites you contact"]],
  ["Account", ["None", "yes"], ["Account required"], ["None"]],
  ["Who sends the requests", ["Your own computer, as you"], ["The company, on your behalf"], ["You"]],
  ["Keeps checking", ["Yes, daily on your PC (your computer must be on and you must be signed in to Windows at the time)"], ["Yes, on a schedule"], ["Only if you remember", "no"]],
  ["Company staff handle hard cases", ["No. Some sites need you to do a step, and it shows you how", "partial"], ["Often, on higher plans"], ["You"]],
];
const comparisonColumns = ["Free My ID", "Paid removal services (typical)", "By hand"];
const cardIcon = "site-refresh__trust-icon";
---

<Base {...pageProps("home")}>
  <div class="site-refresh">
    {/* 1. Hero. The real v0.2.0 screenshot is product proof, not an illustration. */}
    <section class="site-refresh__hero site-refresh__wrap" aria-labelledby="hero-title">
      <div class="site-refresh__hero-copy">
        <p class="site-refresh__eyebrow">Free My ID for Windows</p>
        <h1 class="site-refresh__hero-title" id="hero-title">Take your name off the websites that sell it.</h1>
        {/* source: teardown 4.1; "runs on your own computer, no account, no cloud" = D8 / netpolicy.py */}
        <p class="site-refresh__hero-lead">Free My ID asks the people-search and data-broker sites that list your name, address and phone number to remove them, then keeps checking. It runs on your own computer. No account. No cloud.</p>
        <div class="site-refresh__hero-actions hero-actions">
          <CtaDownload class="site-refresh__button hero-download" />
          <a class="site-refresh__button site-refresh__button--secondary hero-secondary" href={url("how-it-works/")}>See how it works</a>
        </div>
        {/* source: release values from data/release.yaml; PLAN_V1 D5 per-user install */}
        {version ? (
          String(version).startsWith("0.") ? (
            <p class="site-refresh__hero-note">Free for Windows 10 and 11. Version {version} is an early release, so <a href={site.support_mailto}>tell us what confuses you</a>. No account needed: just send an email.</p>
          ) : (
            <p class="site-refresh__hero-note">Free for Windows 10 and 11. Version {version}{release.size_mb ? `, ${release.size_mb} MB` : ""}.</p>
          )
        ) : (
          <p class="site-refresh__hero-note">Free for Windows 10 and 11. The first version is not published yet.</p>
        )}
        {/* source: site_src/data/faq.yaml "Why does Windows warn me" (published copy) */}
        <p class="site-refresh__hero-note">Windows may show a blue "protected your PC" box the first time. <a href={url("download/#smartscreen")}>That's expected. Here's what to click.</a></p>
      </div>
      <figure class="site-refresh__hero-media site-refresh__product-shot">
        <img
          src={homeScreenshot.src}
          width={homeScreenshot.width}
          height={homeScreenshot.height}
          alt="The Free My ID desktop app showing its Welcome screen at step one of six, with an explanation and a Next button."
          fetchpriority="high"
          decoding="async"
        />
        <figcaption class="site-refresh__caption">Example with made-up data</figcaption>
      </figure>
    </section>

    {/* 2. Trust bar: teardown 4.2 items, each linked to its /safety/ section. */}
    <RefreshSection tone="alt" spacing="compact" eyebrow="Our promises">
      <ul class="site-refresh__trustbar" aria-label="Free My ID promises">
        <li><a href={url("safety/#local")}><Icon name="computer" /><span>No account. Runs on your PC. Nothing sent to us.</span></a></li>
        <li><a href={url("safety/#never-asks")}><Icon name="shield" /><span>Never asks for your Social Security number or bank or card details, and never charges you</span></a></li>
        <li><a href={url("safety/#open-source")}><Icon name="code" /><span>Free and open source</span></a></li>
        <li><a href={url("safety/#uninstall")}><Icon name="trash" /><span>Uninstall any time</span></a></li>
      </ul>
    </RefreshSection>

    {/* 3. Proof picture. */}
    <RefreshSection title="See what was asked, and what came back." titleId="proof-title" lead="Free My ID keeps a plain list: which site, when it asked, where things stand, and when it last checked. You can print it.">
      <div class="site-refresh__proof-grid">
        <figure class="site-refresh__figure">
          <img src={url("assets/screenshots/dashboard-1200.webp")} srcset={`${url("assets/screenshots/dashboard-700.webp")} 700w, ${url("assets/screenshots/dashboard-1200.webp")} 1200w`} sizes="(min-width: 62rem) 34rem, 100vw" width="1000" height="1045" loading="lazy" decoding="async" alt="The Free My ID home screen. A plain sentence says 7 sites have confirmed or no longer list you, 3 are waiting and 2 need you, followed by a card with copy-and-paste details and large buttons for the one step left." />
          <figcaption class="site-refresh__caption">Example with made-up data</figcaption>
        </figure>
        <figure class="site-refresh__figure">
          <img src={url("assets/screenshots/report-900.webp")} srcset={`${url("assets/screenshots/report-600.webp")} 600w, ${url("assets/screenshots/report-900.webp")} 900w`} sizes="(min-width: 62rem) 34rem, 100vw" width="900" height="1220" loading="lazy" decoding="async" alt="The printable progress report: a table of each people-search site, its status (site confirmed, asked, not listed now, needs you), when it was last checked and when the request was made." />
          <figcaption class="site-refresh__caption">Example with made-up data. <a href={url("assets/screenshots/report-900.webp")}>See the sample report full size</a></figcaption>
        </figure>
      </div>
      {/* source: teardown 4.3 caveat; brokers/SOURCES.md "Website claims" (no guaranteed timeline) */}
      <p class="site-refresh__prose">Some sites remove you in days. Some take weeks. Some ignore the request, and the report shows those too.</p>
    </RefreshSection>

    {/* 4. How it works. D8: no time estimate in this heading. */}
    <RefreshSection tone="alt" title="How it works, in three steps" titleId="steps-title">
      <RefreshSteps ariaLabel="Three steps to use Free My ID">
        {examples.map(({ art, title, copy }, index) => (
          <li class="site-refresh__step">
            <Art src={art} alt="" class="site-refresh__concept-art" />
            <span class="site-refresh__step-number" aria-hidden="true">{index + 1}</span>
            <h3 class="site-refresh__step-title">{title}</h3>
            <p>{copy}</p>
          </li>
        ))}
      </RefreshSteps>
      <p class="site-refresh__after-steps"><a href={url("how-it-works/")}>Read the details of the three ways</a></p>
    </RefreshSection>

    {/* 5. What it removes. */}
    <RefreshSection id="what-it-removes" title="What people-search sites list about you" titleId="removes-title" lead="People-search sites, also called data brokers, collect public records and sell them to anyone. Here is what they commonly list:">
      {/* source: WR-37; approved home-page categories, sample registry fields */}
      <div class="site-refresh__fact-grid">
        <RefreshCard title="Home address"><Icon name="home" /></RefreshCard>
        <RefreshCard title="Phone numbers"><Icon name="phone" /></RefreshCard>
        <RefreshCard title="Age or birth year"><Icon name="calendar" /></RefreshCard>
      </div>
      {/* source: build data, the number of guides generated from brokers/registry.sample.yaml */}
      <p class="site-refresh__prose">We have {guides.length} step-by-step opt-out guides, and you can use every guide without the app. <a href={url("guides/")}>Browse the guides</a></p>
      {/* source: brokers/checklists.yaml and /protect/ pages */}
      <RefreshCallout title="More free ways to protect yourself" tone="note">
        <p>Freeze your credit, stop pre-approved offers in the mail, and lock down your IRS and Social Security accounts. Plain steps you can print, and you don't need Free My ID for any of them. <a href={url("protect/")}>See the free steps</a>.</p>
      </RefreshCallout>
    </RefreshSection>

    {/* 6. The post. */}
    <RefreshSection tone="alt" width="narrow" title={'You said "I do not consent." Here is how to make it count.'} titleId="post-title">
      <div class="site-refresh__prose">
        {/* source: teardown 4.6; POSITIONING.md legal accuracy and scope */}
        <p>If you shared that post on Facebook, you were right to object. The post just went to the wrong place, and in a form nobody is required to honor. The people who sell your address are the people-search sites, and each has its own removal process. Free My ID sends your request there, in the form each site actually processes, and in states with a broker privacy law, as a formal legal request.</p>
        <p>It does not change what Facebook itself does with your account.</p>
        <p><a href={url("i-do-not-consent/")}>Read: does the "I do not consent" post work?</a></p>
      </div>
    </RefreshSection>

    {/* 7. Comparison (D4). No competitor names. */}
    <RefreshSection id="compare" title="Free My ID, paid removal services, or doing it by hand" titleId="compare-title">
      <div class="site-refresh__compare-scroll" tabindex="0" role="region" aria-labelledby="compare-title">
        <table class="site-refresh__compare">
          <caption>Free My ID compared with paid removal services (typical) and doing it by hand.</caption>
          <thead>
            <tr><th scope="col"><span class="visually-hidden">Question</span></th>{comparisonColumns.map((column) => <th scope="col">{column}</th>)}</tr>
          </thead>
          <tbody>
            {comparisonRows.map(([question, ...cells]) => (
              <tr>
                <th scope="row">{question}</th>
                {cells.map(([copy, mark], index) => (
                  <td data-label={comparisonColumns[index]}>
                    <span class="site-refresh__compare-label">{comparisonColumns[index]}</span>
                    <span class="site-refresh__compare-cell">
                      {mark === "yes" && <Icon name="check" />}
                      {mark === "no" && <Icon name="dash" />}
                      {mark === "partial" && <Icon name="info" />}
                      {copy}
                    </span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {/* source: teardown 4.7 footnote; review date = brokers/SOURCES.md R5 check date */}
      <p class="site-refresh__note">"Typical" describes the category, not any one company. Features and prices vary by service. Reviewed 2026-11-07.</p>
      {/* source: LICENSE; PLAN_V1 (Windows only in v1). WR-26 / WR-38 copy by release state */}
      {version
        ? <p class="site-refresh__prose">Free My ID is open source, so you can read it. Made for Windows 10 and 11. Version {version} is out now.</p>
        : <p class="site-refresh__prose">Free My ID is open source, so you can read it. Made for Windows 10 and 11. The first version is coming soon.</p>}
      <p class="site-refresh__prose">If you'd rather have a company handle it for you, a paid service may suit you better. We'll say so plainly.</p>
    </RefreshSection>

    {/* 8. Safety and privacy. */}
    <RefreshSection tone="alt" title="Built so you can check our work." titleId="safety-title">
      <div class="site-refresh__safety-grid">
        {/* source: D8 encrypted local storage and "Nothing is sent to us"; docs/ROADMAP.md, crypto.py, storage/db.py, netpolicy.py */}
        <RefreshCard title="Your details are stored on your computer. Nothing is sent to us.">
          <p>Your details are stored only on your computer. They go out only to the people-search sites themselves: your name and town to look you up, and removal requests you approve. Your stored details are encrypted. The app talks only to the sites you are asking to remove you, your own email account, and our public list of those sites.</p>
        </RefreshCard>
        {/* source: POSITIONING.md rule 4; shared rule 6; phone only with Permissions.allow_phone_disclosure */}
        <RefreshCard title="It never asks for the wrong things.">
          <p>It never asks for your Social Security number or bank or card details, and never charges you. It gives a site your phone number only if you switch that on. <a href={url("safety/#never-asks")}>See the full list</a>.</p>
        </RefreshCard>
        {/* source: LICENSE; download page SHA256SUMS; freemyid.iss [UninstallRun] removes the daily task */}
        <RefreshCard title="You can check the work.">
          <p>The code is public. {version ? "Every download has" : "Each download will come with"} a fingerprint you can compare. Uninstalling removes the program and its daily check.</p>
        </RefreshCard>
      </div>
      <RefreshCallout title="About the Windows warning">
        <p>Windows may warn "unknown publisher" the first time, because the installer is not yet signed. <a href={url("download/#smartscreen")}>See what the warning looks like and how to check the file</a>.</p>
      </RefreshCallout>
      <div class="site-refresh__honesty-grid">
        <RefreshCard title="Free My ID does">
          <ul>
            <li>Ask people-search and data-broker sites to remove your listing, using each site's own process</li>
            <li>Send a formal legal request where your state's privacy law applies, and a polite request everywhere else</li>
            <li>Click the "confirm your request" links that sites send, and follow up when a site goes quiet</li>
            <li>Check again later, because some sites list people again</li>
            <li>Show you where each site stands: <em>asked</em>, <em>confirmed</em> or <em>still waiting</em></li>
          </ul>
        </RefreshCard>
        <RefreshCard title="Free My ID does not">
          <ul>
            <li>Remove you from every website on the internet. Nobody honest can promise that.</li>
            <li>Change what Facebook itself does with your account</li>
            <li>Stop hacking, phone tapping or government surveillance</li>
            <li>Remove news stories, social media posts or government records</li>
            <li>Ask for your Social Security number or bank or card details, or charge you. Ever.</li>
          </ul>
        </RefreshCard>
      </div>
      <p class="site-refresh__after-steps"><a href={url("safety/")}>Is Free My ID safe? Read the details</a></p>
    </RefreshSection>

    {/* 9. $0 card (D9): one plan only, no second column. */}
    <RefreshSection title="It's free" titleId="price-title" width="narrow">
      <div class="site-refresh__price-card">
        <p class="site-refresh__eyebrow">Free My ID</p>
        <p class="site-refresh__price">$0</p>
        <p>Free. No trial. No card.</p>
        {/* source: D8 verified features: three ways, daily checks, printable report, guides, uninstall */}
        <ul class="site-refresh__price-list">
          <li>Everything the app does, all three ways of sending requests</li>
          <li>Daily re-checks on your PC, while it is on and you are signed in to Windows</li>
          <li>Printable progress report</li>
          <li>Every guide</li>
          <li>Uninstall any time</li>
        </ul>
        <CtaDownload />
      </div>
      <div class="site-refresh__prose site-refresh__why-free">
        <h3>Why is it free?</h3>
        {/* source: teardown section 4.9 "Why is it free?" (the two approved sentences, D9) */}
        <p>Free My ID is open-source software, so anyone can read it and anyone can use it. It exists to help ordinary people, starting with the author's own family.</p>
      </div>
    </RefreshSection>

    {/* 10. Helpers. */}
    <RefreshSection tone="alt" title="Helping a parent or grandparent?" titleId="helpers-title" lead="Set it up once on their computer, and it keeps working. They stay in control, and can stop or uninstall at any time.">
      <div class="site-refresh__helper-grid">
        <div class="site-refresh__prose">
          {/* source: teardown 4.10 minus unverified time and printable-sheet claims; USER_GUIDE.md sections 3 and 4 */}
          <ul>
            <li>Set it up on their computer in one visit, or protect several family members from one computer.</li>
            <li>Each adult gives their own permission. Free My ID won't work on anyone without it.</li>
            <li>Practice mode comes first, so no removal requests go out until you say so.</li>
          </ul>
          <p>Windows only for now. The person whose information is listed should agree to this.</p>
          <div class="site-refresh__actions">
            <CtaDownload look="secondary" size="md" />
            <a class="site-refresh__button site-refresh__button--secondary" href={url("families/")}>Read the helper's guide</a>
          </div>
        </div>
        <Art src="sections/families-help" alt="A grown child helping a parent at a laptop." class="site-refresh__family-art" />
      </div>
    </RefreshSection>

    {/* 11. FAQ: home:true entries in data/faq.yaml; first two open. */}
    <RefreshSection title="Common questions" titleId="faq-title" width="narrow">
      <FaqList items={homeFaq} openFirst={2} />
      <p class="site-refresh__after-steps"><a href={url("faq/")}>See all questions</a></p>
    </RefreshSection>

    {/* 12. Final CTA. */}
    <RefreshSection tone="brand" width="narrow" title="Your information. Off the market." titleId="cta-title">
      <div class="site-refresh__final-cta">
        {/* source: approved home copy; once a day = D8; WR-8 source link */}
        <p class="site-refresh__lead">Free, open source, and it runs on your own computer, checking once a day while your PC is on and you are signed in to Windows. <a href={url("safety/#open-source")}>How you can check our work</a>.</p>
        <CtaDownload look="onBrand" />
        {/* source: teardown 4.12; BRAND.md trust panel */}
        <p>No account. No cloud. Never asks for your Social Security number or bank or card details, and never charges you. Uninstall any time.</p>
      </div>
    </RefreshSection>
  </div>
</Base>

<style>
  .site-refresh .site-refresh__trustbar,
  .site-refresh .site-refresh__fact-grid,
  .site-refresh .site-refresh__safety-grid,
  .site-refresh .site-refresh__honesty-grid {
    display: grid;
    gap: var(--fmi-space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-refresh .site-refresh__trustbar a {
    align-items: center;
    background: var(--fmi-color-card);
    border: 1px solid var(--fmi-color-line);
    border-radius: var(--fmi-radius-lg);
    box-shadow: var(--fmi-shadow-1);
    display: flex;
    gap: var(--fmi-space-s);
    height: 100%;
    min-block-size: 4rem;
    padding: var(--fmi-space-m);
    text-decoration: none;
  }

  .site-refresh .site-refresh__trustbar svg {
    color: var(--fmi-color-brand);
    flex: 0 0 1.75rem;
    height: 1.75rem;
    width: 1.75rem;
  }

  .site-refresh .site-refresh__proof-grid {
    display: grid;
    gap: var(--fmi-space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 25rem), 1fr));
  }

  .site-refresh .site-refresh__product-shot img {
    width: 100%;
  }

  .site-refresh .site-refresh__concept-art {
    height: auto;
    margin-block-end: var(--fmi-space-s);
    max-width: 11rem;
    width: 100%;
  }

  .site-refresh .site-refresh__after-steps,
  .site-refresh .site-refresh__note {
    margin-block: var(--fmi-space-l) 0;
  }

  .site-refresh .site-refresh__fact-grid {
    margin-block-end: var(--fmi-space-l);
  }

  .site-refresh .site-refresh__fact-grid article {
    align-items: center;
    display: flex;
    gap: var(--fmi-space-s);
  }

  .site-refresh .site-refresh__fact-grid article :global(svg) {
    color: var(--fmi-color-brand);
    flex: 0 0 1.5rem;
    height: 1.5rem;
    width: 1.5rem;
  }

  .site-refresh .site-refresh__compare-scroll {
    border: 1px solid var(--fmi-color-line);
    border-radius: var(--fmi-radius-lg);
    box-shadow: var(--fmi-shadow-1);
    max-width: 100%;
    overflow-x: auto;
  }

  .site-refresh .site-refresh__compare-scroll:focus-visible {
    outline: 3px solid var(--fmi-color-focus);
    outline-offset: 3px;
  }

  .site-refresh .site-refresh__compare {
    background: var(--fmi-color-card);
    border-collapse: collapse;
    min-width: 48rem;
    width: 100%;
  }

  .site-refresh .site-refresh__compare th,
  .site-refresh .site-refresh__compare td {
    border-block-end: 1px solid var(--fmi-color-line);
    padding: var(--fmi-space-m);
    text-align: start;
    vertical-align: top;
  }

  .site-refresh .site-refresh__compare thead {
    background: var(--fmi-color-bg-alt);
  }

  .site-refresh .site-refresh__compare th {
    color: var(--fmi-color-heading);
  }

  .site-refresh .site-refresh__compare-label {
    display: none;
    font-weight: 700;
  }

  .site-refresh .site-refresh__compare-cell {
    align-items: start;
    display: flex;
    gap: var(--fmi-space-2xs);
  }

  .site-refresh .site-refresh__compare-cell svg {
    color: var(--fmi-color-ok);
    flex: 0 0 1.25rem;
    height: 1.25rem;
    width: 1.25rem;
  }

  .site-refresh .site-refresh__price-card {
    align-items: center;
    background: var(--fmi-color-card);
    border: 1px solid var(--fmi-color-line);
    border-radius: var(--fmi-radius-xl);
    box-shadow: var(--fmi-shadow-2);
    display: grid;
    justify-items: center;
    padding: var(--fmi-space-xl);
    text-align: center;
  }

  .site-refresh .site-refresh__price {
    color: var(--fmi-color-heading);
    font-size: clamp(3rem, 10vw, 5rem);
    font-weight: 800;
    line-height: 1;
    margin-block: var(--fmi-space-s);
  }

  .site-refresh .site-refresh__price-list {
    justify-self: stretch;
    margin-block: var(--fmi-space-m);
    text-align: start;
  }

  .site-refresh .site-refresh__why-free {
    margin-block-start: var(--fmi-space-xl);
  }

  .site-refresh .site-refresh__helper-grid {
    align-items: center;
    display: grid;
    gap: var(--fmi-space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
  }

  .site-refresh .site-refresh__family-art {
    height: auto;
    justify-self: center;
    max-width: 24rem;
    width: 100%;
  }

  .site-refresh .site-refresh__final-cta {
    display: grid;
    gap: var(--fmi-space-m);
    justify-items: start;
  }

  .site-refresh .hero-actions {
    display: grid;
    gap: var(--fmi-space-s);
    grid-template-columns: minmax(0, 1fr);
    max-width: 100%;
    width: 100%;
  }

  .site-refresh .hero-actions :global(.hero-download),
  .site-refresh .hero-actions .hero-secondary {
    justify-content: center;
    min-block-size: 3.25rem;
    min-width: 0;
    width: 100%;
    white-space: normal;
  }

  @media (min-width: 48em) and (max-width: 56.2499em) {
    .site-refresh .hero-actions {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
    }

    .site-refresh .hero-actions :global(.hero-download),
    .site-refresh .hero-actions .hero-secondary {
      width: auto;
    }
  }

  @media (min-width: 56.25em) {
    .site-refresh .hero-actions {
      width: max-content;
    }

    .site-refresh .hero-actions :global(.hero-download) {
      padding-inline: var(--fmi-space-l);
    }

    .site-refresh .hero-actions .hero-secondary {
      justify-content: flex-start;
