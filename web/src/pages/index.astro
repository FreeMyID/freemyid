---
// Home, v3. Same order (D10) and copy as site_src/templates/pages/home.html (teardown section 4 minus
// D8 exclusions, WR-25..38). Every Download button goes through CtaDownload (D5). Source comments
// are carried over from the v2 template. Zero client JS on this page.
import Base from "@/layouts/Base.astro";
import Section from "@/components/Section.astro";
import CtaDownload from "@/components/CtaDownload.astro";
import Icon from "@/components/Icon.astro";
import Art from "@/components/Art.astro";
import Card from "@/components/ui/Card.astro";
import Alert from "@/components/ui/Alert.astro";
import FaqList from "@/components/FaqList.astro";
import Marquee from "@/components/magicui/Marquee.astro";
import { buttonVariants } from "@/components/ui/button-variants";
import { faq, guides, pageProps, release, site, url } from "@/lib/site";

const v = release.version;
const homeFaq = faq.filter((q) => q.home);
const btnGhost = buttonVariants({ variant: "ghost", size: "lg" });
const cardIcon = "inline-flex size-12 items-center justify-center rounded-lg bg-brand-soft text-brand [&_svg]:size-7";
---
<Base {...pageProps("home")}>

{/* 1. Hero */}
<section class="overflow-hidden bg-[radial-gradient(ellipse_at_top_right,var(--fmi-color-brand-soft),transparent_60%)] py-2xl" aria-labelledby="hero-title">
  <div class="wrap grid items-center gap-xl min-[56.25em]:grid-cols-[1.1fr_1fr]">
    <div>
      {/* source: teardown 4.1; LICENSE (AGPL); Windows-only v1 (docs/PLAN_V1.md) */}
      <p class="mb-s inline-flex items-center gap-2xs rounded-pill border border-line bg-card px-s py-3xs text-small font-bold text-brand">
        <Icon name="shield" />Free. Open source. For Windows.
      </p>
      <h1 id="hero-title" class="text-display">Take your name off the websites that sell it.</h1>
      {/* source: teardown 4.1; "runs on your own computer, no account, no cloud" = D8 / netpolicy.py */}
      <p class="mt-m max-w-measure text-lead text-muted">Free My ID asks the people-search and data-broker sites that list your name, address and phone number to remove them, then keeps checking. It runs on your own computer. No account. No cloud.</p>
      <div class="mt-l flex flex-wrap items-center gap-s">
        <CtaDownload beam />
        <a class={btnGhost} href={url("how-it-works/")}>See how it works</a>
      </div>
      {/* source: release values from data/release.yaml; PLAN_V1 D5 per-user install */}
      {v ? (
        String(v).startsWith("0.") ? (
          // WR-38: brand-marketing copy for an early (0.x) release. Owner rule (ROADMAP principle 6): users never need an
          // account and never land on github.com, so feedback goes by email (site.yaml support_mailto, subject only, no body)
          <p class="mt-m text-small text-muted">Free for Windows 10 and 11. Version {v} is an early release, so <a href={site.support_mailto}>tell us what confuses you</a>. No account needed: just send an email.</p>
        ) : (
          <p class="mt-m text-small text-muted">Free for Windows 10 and 11. Version {v}{release.size_mb ? `, ${release.size_mb} MB` : ""}.</p>
        )
      ) : (
        <p class="mt-m text-small text-muted">Free for Windows 10 and 11. The first version is not published yet.</p>
      )}
      {/* source: site_src/data/faq.yaml "Why does Windows warn me" (published copy) */}
      <p class="mt-2xs text-small text-muted">Windows may show a blue "protected your PC" box the first time. <a href={url("download/#smartscreen")}>That's expected. Here's what to click.</a></p>
    </div>
    <figure class="hero-art mx-auto w-full max-w-[32rem]">
      {/* brand/v3/hero.svg, alt text from brand/v3/README.md */}
      <Art src="hero" alt="A person at home, with their name card coming back from three web pages." />
    </figure>
  </div>
</section>

{/* 2. Trust bar: teardown 4.2 items, each linked to its /safety/ section */}
<Section tight tone="alt" label="Our promises" class="border-y border-line">
  <ul class="grid gap-s min-[40em]:grid-cols-2 min-[64em]:grid-cols-4" role="list">
    {[
      // source: D8 "Nothing is sent to us" (netpolicy.py); no account (PLAN_V1)
      ["safety/#local", "computer", "No account. Runs on your PC. Nothing sent to us."],
      // source: POSITIONING.md rule 4; safety page never-asks list
      ["safety/#never-asks", "shield", "Never asks for your Social Security number, bank or card details"],
      // source: LICENSE (GNU AGPL v3)
      ["safety/#open-source", "code", "Free and open source"],
      // source: packaging/windows/freemyid.iss (Windows Settings uninstall, removes the daily task)
      ["safety/#uninstall", "trash", "Uninstall any time"],
    ].map(([href, icon, text]) => (
      <li>
        <a class="flex h-full min-h-tap items-center gap-s rounded-xl border border-line bg-card p-s font-semibold text-heading no-underline shadow-1 hover:border-line-strong" href={url(href)}>
          <span class={cardIcon}><Icon name={icon} /></span><span>{text}</span>
        </a>
      </li>
    ))}
  </ul>
</Section>

{/* 3. Proof picture */}
<Section title="See exactly what was asked, and what came back." titleId="proof-title">
  {/* source: teardown 4.3, narrowed to what the shipped report shows: D8 "Printable progress report" with site names, states and dates only (src/freemyid/wizard/report.py) */}
  <p slot="lead">Free My ID keeps a plain list: which site, when it asked, where things stand, and when it last checked. You can print it.</p>
  <div class="grid items-start gap-l min-[56.25em]:grid-cols-2">
    <figure class="reveal mx-auto w-full max-w-[34rem] overflow-hidden rounded-xl border border-line bg-card shadow-2">
      {/* D7: real screenshot, fake persona. Alt text: brand/README.md. WR-35 srcset */}
      <img src={url("assets/screenshots/dashboard-1200.webp")} srcset={`${url("assets/screenshots/dashboard-700.webp")} 700w, ${url("assets/screenshots/dashboard-1200.webp")} 1200w`} sizes="(min-width: 62rem) 30rem, (min-width: 56.25em) 48vw, 100vw" width="1000" height="1045" loading="lazy" decoding="async" alt="The Free My ID home screen. A plain sentence says 7 sites have confirmed or no longer list you, 3 are waiting and 2 need you, followed by a card with copy-and-paste details and large buttons for the one step left.">
      <figcaption class="border-t border-line px-m py-xs text-small text-muted">Example with made-up data</figcaption>
    </figure>
    <figure class="reveal mx-auto w-full max-w-[34rem] overflow-hidden rounded-xl border border-line bg-card shadow-2">
      {/* WR-35: 600w/900w srcset. The link below opens the 900px image. */}
      <img src={url("assets/screenshots/report-900.webp")} srcset={`${url("assets/screenshots/report-600.webp")} 600w, ${url("assets/screenshots/report-900.webp")} 900w`} sizes="(min-width: 62rem) 30rem, (min-width: 56.25em) 48vw, 100vw" width="900" height="1220" loading="lazy" decoding="async" alt="The printable progress report: a table of each people-search site, its status (site confirmed, asked, not listed now, needs you), when it was last checked and when the request was made.">
      <figcaption class="border-t border-line px-m py-xs text-small text-muted">Sample report with made-up data. <a href={url("assets/screenshots/report-900.webp")}>See the sample report full size</a></figcaption>
    </figure>
  </div>
  {/* source: teardown 4.3 caveat; brokers/SOURCES.md "Website claims" (no guaranteed timeline) */}
  <p class="mt-l max-w-measure">Some sites remove you in days. Some take weeks. Some ignore the request, and the report shows those too.</p>
</Section>

{/* 4. How it works. D8: no time estimate in this heading. */}
<Section tone="alt" title="How it works, in three steps" titleId="steps-title">
  <ol class="grid gap-m min-[56.25em]:grid-cols-3" role="list">
    {[
      // source: D8 "Six short screens" (wizard/draft.py STEPS); POSITIONING.md rule 4
      ["step-who", "Tell it who to protect.", "Six short screens: your name and the towns you have lived in. It never asks for your Social Security number or bank details."],
      // source: PLAN_V1 D1 three tiers; shared rule 6 (Listing.shown_fields)
      ["step-send", "It sends the requests.", "By email, by walking you through a site's form, or by filling the form in while you watch. Each site gets only what it already shows about you."],
      // source: D8 "Checks once a day" (PLAN_V1 D4, Task Scheduler)
      ["step-report", "It keeps checking.", "Once a day, quietly in the background, while your computer is on and you are signed in. You see who confirmed, who is still waiting, and it asks again if a site lists you again."],
    ].map(([art, h, p], i) => (
      <Card as="li" class="reveal">
        <Art src={`sections/${art}`} class="mx-auto mb-xs max-w-[18rem] rounded-lg bg-bg-alt" />
        <span class="inline-flex size-10 items-center justify-center rounded-full bg-brand text-lead font-bold text-brand-ink" aria-hidden="true">{i + 1}</span>
        <h3>{h}</h3>
        <p>{p}</p>
      </Card>
    ))}
  </ol>
  <p class="mt-l"><a href={url("how-it-works/")}>Read the details of the three ways</a></p>
</Section>

{/* 5. What it removes */}
<Section id="what-it-removes" title="What people-search sites are selling about you." titleId="removes-title"
  lead="People-search sites, also called data brokers, collect public records and sell them to anyone. Here is what they commonly list:">
  {/* source (WR-37): the card list is what the people-search sites themselves list (address, phone, age, relatives, as on the
     old approved home page); sample registry search/opt-out fields cover address, phone and age. Not the CFPB 2024 proposed rule
     (withdrawn 15 May 2025, 90 FR 20568). Teardown's "past addresses" and "email addresses" cards left out until sourced. */}
  <ul class="grid grid-cols-2 gap-s min-[56.25em]:grid-cols-3" role="list">
    {[["home", "Home address"], ["phone", "Phone numbers"], ["calendar", "Age or birth year"]].map(([icon, h]) => (
      <Card as="li" class="reveal items-start">
        <span class={cardIcon}><Icon name={icon} /></span>
        <h3 class="text-lead">{h}</h3>
      </Card>
    ))}
  </ul>
  {/* source: build data, the number of guides generated from brokers/registry.sample.yaml */}
  <p class="mt-l">We have {guides.length} step-by-step opt-out guides, and you can use every guide without the app. <a href={url("guides/")}>Browse the guides</a></p>
  {/* source: brokers/checklists.yaml (credit freezes, prescreen opt-out, IRS IP PIN, SSA, USPS; free except DMAchoice); /protect/ pages */}
  <Card class="reveal mt-l max-w-[48rem] items-start p-l shadow-2">
    <span class={cardIcon}><Icon name="shield" /></span>
    <h3>More free ways to protect yourself</h3>
    <p>Freeze your credit, stop pre-approved offers in the mail, and lock down your IRS and Social Security accounts. Plain steps you can print, and you don't need Free My ID for any of them.</p>
    <p><a href={url("protect/")}>See the free steps</a></p>
  </Card>
  {/* names = the same build data (public sample registry); decorative repeat of the guides list */}
  <Marquee id="guide-marquee" label={`Sites and services with a free guide (${guides.length})`} items={guides.map((g) => g.name)} />
</Section>

{/* 6. The post */}
<Section tone="alt" narrow title={'You said "I do not consent." Here is how to make it count.'} titleId="post-title">
  <div class="prose-fmid">
    {/* source: teardown 4.6; POSITIONING.md core message and "Legal accuracy" (formal request only where a state law applies) */}
    <p>If you shared that post on Facebook, you were right to object. The post just went to the wrong place, and in a form nobody is required to honor. The people who sell your address are the people-search sites, and each has its own removal process. Free My ID sends your request there, in the form each site actually processes, and in states with a broker privacy law, as a formal legal request.</p>
    {/* source: POSITIONING.md rule 6 (scope) */}
    <p>It does not change what Facebook itself does with your account.</p>
    <p><a href={url("i-do-not-consent/")}>Read: does the "I do not consent" post work?</a></p>
  </div>
</Section>

{/* 7. Comparison (D4). No competitor names. */}
<Section id="compare" title="Free My ID, paid removal services, or doing it by hand" titleId="compare-title">
  {/* source (Free My ID + By hand columns): PLAN_V1 D1/D4, D8 verified claims, netpolicy.py, shared rule 5 (some sites need a human step) */}
  {/* source: brokers/SOURCES.md "Website claims: comparison (R5)" (paid column: approved cell text only; rows without an approved cell are left out) */}
  <div class="overflow-x-auto rounded-xl border border-line bg-card shadow-1" tabindex="0" role="region" aria-labelledby="compare-title">
    <table class="w-full border-collapse text-start max-[34em]:block">
      <caption class="visually-hidden">Free My ID compared with paid removal services (typical) and doing it by hand</caption>
      <thead class="bg-surface max-[34em]:hidden">
        <tr>
          <th scope="col" class="p-s text-start"><span class="visually-hidden">Question</span></th>
          <th scope="col" class="p-s text-start text-heading">Free My ID</th>
          <th scope="col" class="p-s text-start text-heading">Paid removal services (typical)</th>
          <th scope="col" class="p-s text-start text-heading">By hand</th>
        </tr>
      </thead>
      <tbody class="max-[34em]:block">
        {([
          ["Price", ["Free", "yes"], ["Yearly or monthly fee"], ["Free, your time"]],
          ["Where your details go", ["Only to the sites you ask to remove you", "yes"], ["Sent to the company"], ["Only to the sites you contact"]],
          ["Account", ["None", "yes"], ["Account required"], ["None"]],
          ["Who sends the requests", ["Your own computer, as you"], ["The company, on your behalf"], ["You"]],
          ["Keeps checking", ["Yes, daily on your PC (your computer must be on and you must be signed in to Windows at the time)", "yes"], ["Yes, on a schedule"], ["Only if you remember", "no"]],
          ["Company staff handle hard cases", ["No. Some sites need you to do a step, and it shows you how", "partial"], ["Often, on higher plans"], ["You"]],
        ] as [string, string[], string[], string[]][]).map(([row, ...cells]) => (
          <tr class="border-t border-line max-[34em]:block max-[34em]:p-s">
            <th scope="row" class="p-s text-start align-top text-heading max-[34em]:block max-[34em]:p-0 max-[34em]:text-lead">{row}</th>
            {cells.map(([text, mark], i) => {
              const col = ["Free My ID", "Paid removal services (typical)", "By hand"][i];
              return (
                <td data-label={col} class:list={["p-s align-top max-[34em]:block max-[34em]:px-0 max-[34em]:py-3xs", i === 0 && "bg-brand-soft/60 max-[34em]:bg-transparent"]}>
                  <span class="hidden text-small font-bold text-muted max-[34em]:block">{col}</span>
                  <span class="inline-flex items-start gap-2xs">
                    {mark === "yes" && <Icon name="check" class="mt-[0.2em] text-ok" />}
                    {mark === "no" && <Icon name="dash" class="mt-[0.2em] text-muted" />}
                    {mark === "partial" && <Icon name="info" class="mt-[0.2em] text-warn" />}
                    <span>{text}</span>
                  </span>
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {/* source: teardown 4.7 footnote; review date = brokers/SOURCES.md R5 check date */}
  <p class="mt-s text-small text-muted">"Typical" describes the category, not any one company. Features and prices vary by service. Reviewed 2026-11-07.</p>
  {/* source: LICENSE (AGPL); PLAN_V1 (Windows only in v1). WR-26 / WR-38 copy by release state */}
  {v
    ? <p class="mt-m">Free My ID is open source, so you can read it. Made for Windows 10 and 11. Version {v} is out now.</p>
    : <p class="mt-m">Free My ID is open source, so you can read it. Made for Windows 10 and 11. The first version is coming soon.</p>}
  {/* source: D4 "where paid services are better" line; wording per orchestrator ruling, docs/WEBSITE_REDESIGN.md */}
  <p class="mt-s">If you'd rather have a company handle it for you, a paid service may suit you better. We'll say so plainly.</p>
</Section>

{/* 8. Safety and privacy. WR-28: heading not absolute. */}
<Section tone="alt" title="Built so you can check our work." titleId="safety-title">
  <ul class="grid gap-m min-[56.25em]:grid-cols-3" role="list">
    {/* source: teardown 4.8; D8 encrypted (crypto.py, storage/db.py) and "Nothing is sent to us" (netpolicy.py); headline per WR-25 */}
{/* source: docs/ROADMAP.md section 1 privacy promise; docs/POSITIONING.md privacy scope (WR-70) */}
    <Card as="li" class="reveal"><span class={cardIcon}><Icon name="lock" /></span><h3>Your details are stored on your computer. Nothing is sent to us.</h3><p>Your details are stored only on your computer. They go out only in a removal request you approve, sent straight to that one site. Your stored details are encrypted. The app talks only to the sites you are asking to remove you, your own email account, and our public list of those sites.</p></Card>
    {/* source: teardown 4.8; POSITIONING.md rule 4; shared rule 6 (never pay; phone/ID only with permission) */}
    <Card as="li" class="reveal"><span class={cardIcon}><Icon name="shield" /></span><h3>It never asks for the wrong things.</h3><p>Never your Social Security number. Never bank or card details. Never a payment. Never a phone number or ID unless you choose to.</p></Card>
    {/* source: teardown 4.8; LICENSE; download page SHA256SUMS; freemyid.iss [UninstallRun] removes the daily task */}
    <Card as="li" class="reveal"><span class={cardIcon}><Icon name="code" /></span><h3>You can check the work.</h3><p>The code is public. {v ? "Every download has" : "Each download will come with"} a fingerprint you can compare. Uninstalling removes the program and its daily check.</p></Card>
  </ul>
  {/* source: teardown 4.8 callout; installer ships unsigned */}
  <Alert class="mt-l"><p>Windows may warn "unknown publisher" the first time, because the installer is not yet signed. <a href={url("download/#smartscreen")}>See what the warning looks like and how to check the file</a>.</p></Alert>
  {/* Does / doesn't box: approved copy from the old home page "What it does, honestly" */}
  <div class="grid gap-m min-[56.25em]:grid-cols-2">
    <Card class="border-t-4 border-t-ok">
      <h3>Free My ID does</h3>
      <ul class="grid gap-xs" role="list">
        {[
          "Ask people-search and data-broker sites to remove your listing, using each site's own process",
          // source: POSITIONING.md "Legal accuracy"
          "Send a formal legal request where your state's privacy law applies, and a polite request everywhere else",
          'Click the "confirm your request" links that sites send, and follow up when a site goes quiet',
          "Check again later, because some sites list people again",
        ].map((t) => <li class="flex gap-2xs"><Icon name="check" class="mt-[0.25em] text-ok" /><span>{t}</span></li>)}
        <li class="flex gap-2xs"><Icon name="check" class="mt-[0.25em] text-ok" /><span>Show you where each site stands: <em>asked</em>, <em>confirmed</em> or <em>still waiting</em></span></li>
      </ul>
    </Card>
    <Card class="border-t-4 border-t-line-strong">
      <h3>Free My ID does not</h3>
      <ul class="grid gap-xs" role="list">
        {[
          "Remove you from every website on the internet. Nobody honest can promise that.",
          "Change what Facebook itself does with your account",
          "Stop hacking, phone tapping or government surveillance",
          "Remove news stories, social media posts or government records",
          "Ask for your Social Security number, bank or card details. Ever.",
        ].map((t) => <li class="flex gap-2xs"><Icon name="x" class="mt-[0.25em] text-muted" /><span>{t}</span></li>)}
      </ul>
    </Card>
  </div>
  <p class="mt-l"><a href={url("safety/")}>Is Free My ID safe? Read the details</a></p>
</Section>

{/* 9. $0 card (D9): one plan only, no second column */}
<Section title="It's free" titleId="price-title">
  <Card class="reveal mx-auto max-w-[28rem] items-center gap-s p-l text-center shadow-2">
    <p class="font-bold text-brand">Free My ID</p>
    <p class="text-display font-bold leading-none text-heading">$0</p>
    <p class="text-muted">Free. No trial. No card.</p>
    {/* source: D8 verified features: three ways (PLAN_V1 D1), daily checks (PLAN_V1 D4), printable report (wizard/report.py), guides (build data), uninstall (freemyid.iss). */}
    <ul class="my-xs grid gap-xs text-start" role="list">
      {["Everything the app does, all three ways of sending requests", "Daily re-checks on your PC", "Printable progress report", "Every guide", "Uninstall any time"]
        .map((t) => <li class="flex gap-2xs"><Icon name="check" class="mt-[0.25em] text-ok" /><span>{t}</span></li>)}
    </ul>
    <CtaDownload />
  </Card>
  <div class="mx-auto mt-l max-w-measure">
    <h3>Why is it free?</h3>
    {/* source: teardown section 4.9 "Why is it free?" (the two approved sentences, D9) */}
    <p class="mt-xs">Free My ID is open-source software, so anyone can read it and anyone can use it. It exists to help ordinary people, starting with the author's own family.</p>
  </div>
</Section>

{/* 10. Helpers */}
<Section tone="alt" title="Helping a parent or grandparent?" titleId="helpers-title"
  lead="Set it up once on their computer, and it keeps working. They stay in control, and can stop or uninstall at any time.">
  {/* source: teardown 4.10 minus the unverified time and printable-sheet claims */}
  <div class="grid items-center gap-xl min-[56.25em]:grid-cols-[1.2fr_1fr]">
    <div class="prose-fmid">
      {/* source: old home page helper list: docs/USER_GUIDE.md sections 3 and 4; faq "Can I set it up for my parents?" */}
      <ul>
        <li>Set it up on their computer in one visit, or protect several family members from one computer.</li>
        <li>Each adult gives their own permission. Free My ID won't work on anyone without it.</li>
        <li>Practice mode comes first, so nothing is sent until you say so.</li>
      </ul>
      <p>Windows only for now. The person whose information is listed should agree to this.</p>
      <div class="flex flex-wrap gap-s pt-xs">
        <CtaDownload look="secondary" size="md" />
        <a class={buttonVariants({ variant: "ghost" })} href={url("families/")}>Read the helper's guide</a>
      </div>
    </div>
    <Art src="sections/families-help" alt="A grown child helping a parent at a laptop." class="reveal mx-auto max-w-[26rem]" />
  </div>
</Section>

{/* 11. FAQ: the home: true entries in data/faq.yaml, first two open */}
<Section narrow title="Common questions" titleId="faq-title">
  <FaqList items={homeFaq} openFirst={2} />
  <p class="mt-l"><a href={url("faq/")}>See all questions</a></p>
</Section>

{/* 12. Final CTA */}
<section class="bg-band-brand py-2xl text-center text-band-brand-ink" aria-labelledby="cta-title">
  <div class="wrap-narrow grid justify-items-center gap-m">
    <h2 id="cta-title" class="text-band-brand-ink">Your information. Off the market.</h2>
    {/* source: old home final CTA (approved copy); once a day = D8; WR-8 source link (repo public) */}
    <p class="text-lead">Free, open source, and it runs on your own computer, checking once a day. <a class="text-band-brand-ink" href={url("safety/#open-source")}>How you can check our work</a>.</p>
    <CtaDownload look="onBrand" />
    {/* source: teardown 4.12; BRAND.md trust panel */}
    <p class="text-small">No account. No cloud. Never asks for your Social Security number. Uninstall any time.</p>
  </div>
</section>
</Base>
