---
// Bento grid (aceternity/magicui "Bento Grid"): a list of BentoItem tiles. 1 column on phones,
// 2 from 40em, `cols` (2 or 3) from 64em.
import { cn } from "@/lib/utils";
interface Props { cols?: 2 | 3; class?: string; label?: string }
const { cols = 3, class: cls, label } = Astro.props;
---
<ul class={cn("bento", cols === 3 && "bento--3", cls)} role="list" aria-label={label}><slot /></ul>
