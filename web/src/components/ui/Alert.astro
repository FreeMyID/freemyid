---
// shadcn/ui Alert, ported to Astro. Calm callouts only: never a red alarm box.
// variant: info (brand tint, default) | note (grey) | ok (green tint) | warn (amber tint, "heads-up").
// title: optional bold first line. icon: any Icon name (each variant has a sensible default).
import { cn } from "@/lib/utils";
import Icon from "../Icon.astro";
interface Props { variant?: "info" | "note" | "ok" | "warn"; icon?: string; title?: string; class?: string; id?: string }
const { variant = "info", title, class: cls, id } = Astro.props;
const icon = Astro.props.icon ?? { info: "info", note: "info", ok: "check-circle", warn: "clock" }[variant];
const look = {
  info: "border-line bg-brand-soft text-text",
  note: "border-line bg-surface text-text",
  ok: "border-ok/30 bg-ok-soft text-text",
  warn: "border-warn/30 bg-warn-soft text-text",
}[variant];
const iconColor = { info: "text-brand", note: "text-brand", ok: "text-ok", warn: "text-warn" }[variant];
---
<aside data-slot="alert" id={id} class={cn("my-m flex gap-s rounded-xl border p-m", look, cls)}>
  <Icon name={icon} class={cn("mt-[0.2em] size-[1.3em] shrink-0", iconColor)} />
  <div class="prose-fmid min-w-0 [&_p]:m-0">
    {title && <p class="!mb-3xs font-bold text-heading">{title}</p>}
    <slot />
  </div>
</aside>
