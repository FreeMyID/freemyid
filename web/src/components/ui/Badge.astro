---
// shadcn/ui Badge, ported to Astro. Variants map to Free My ID status colors (never alarm red).
import { cva } from "class-variance-authority";
import { cn } from "@/lib/utils";
const badge = cva("inline-flex items-center gap-3xs rounded-pill border px-xs py-3xs text-small font-bold", {
  variants: {
    variant: {
      default: "border-line bg-surface text-text",
      ok: "border-ok bg-card text-ok",
      warn: "border-warn bg-card text-warn",
      brand: "border-transparent bg-brand-soft text-heading",
    },
  },
  defaultVariants: { variant: "default" },
});
interface Props { variant?: "default" | "ok" | "warn" | "brand"; class?: string }
const { variant, class: cls } = Astro.props;
---
<span data-slot="badge" class={cn(badge({ variant }), cls)}><slot /></span>
