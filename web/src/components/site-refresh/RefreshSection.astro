---
interface Props {
  title?: string;
  titleId?: string;
  eyebrow?: string;
  lead?: string;
  tone?: "plain" | "alt" | "brand";
  spacing?: "normal" | "compact";
  width?: "wide" | "narrow";
}

const {
  title,
  titleId,
  eyebrow,
  lead,
  tone = "plain",
  spacing = "normal",
  width = "wide",
} = Astro.props;
const classes = [
  "site-refresh__section",
  tone !== "plain" && `site-refresh__section--${tone}`,
  spacing === "compact" && "site-refresh__section--compact",
];
---

<section class:list={classes} aria-labelledby={title ? titleId : undefined}>
  <div class:list={["site-refresh__wrap", width === "narrow" && "site-refresh__wrap--narrow"]}>
    {(title || eyebrow || lead) && (
      <header class="site-refresh__section-head">
        {eyebrow && <p class="site-refresh__eyebrow">{eyebrow}</p>}
        {title && <h2 id={titleId}>{title}</h2>}
        {lead && <p class="site-refresh__lead">{lead}</p>}
      </header>
    )}
    <slot />
  </div>
</section>
