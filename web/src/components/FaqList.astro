---
// FAQ list from site_src/data/faq.yaml. Native <details>, styled like the shadcn/ui Accordion
// (works with JS off and prints open). Answers are rendered through the rich-text allowlist.
import type { Faq } from "@/lib/site";
import { rich } from "@/lib/rich";
import RichText from "./RichText.astro";
import Icon from "./Icon.astro";
interface Props { items: Faq[]; openFirst?: number }
const { items, openFirst = 0 } = Astro.props;
---
<div class="divide-y divide-line rounded-xl border border-line bg-card shadow-1">
  {items.map((q, i) => (
    <details class="faq-item group" id={`q-${q.id}`} open={i < openFirst}>
      <summary class="flex min-h-tap items-center justify-between gap-s px-m py-s text-lead font-bold text-heading hover:bg-brand-soft">
        <span>{q.q}</span>
        <Icon name="chevron-down" class="faq-chevron size-6 text-brand transition-transform duration-200 motion-reduce:transition-none" />
      </summary>
      <div class="prose-fmid px-m pb-m"><RichText nodes={rich(q.a)} /></div>
    </details>
  ))}
</div>
