---
// Aceternity UI "Timeline", split into static + enhancement: a numbered list with a grey rail
// (static HTML, works with JS off) and a coloured beam that fills as you scroll.
//   beam="css"    (default) scroll-driven CSS animation, zero JS; static full beam where unsupported
//   beam="island" the Aceternity motion version as a React island (TimelineBeam.tsx, client:visible).
//                 Costs ~95 KB gzip (React + motion), so it is used on /how-it-works/ only.
// Both are off under prefers-reduced-motion (the beam is shown full and still).
import TimelineBeam from "./TimelineBeam.tsx";
interface Props { class?: string; beam?: "css" | "island" | "none" }
const { beam = "css" } = Astro.props;
---
<div class:list={["timeline relative", Astro.props.class]}>
  <div class="absolute inset-y-0 start-[calc(1.25rem-2px)] w-1 rounded-full bg-line" aria-hidden="true"></div>
  {beam === "css" && (
    <div class="absolute inset-y-0 start-[calc(1.25rem-2px)] w-1 overflow-hidden rounded-full" aria-hidden="true">
      <div class="timeline__beam h-full w-full origin-top rounded-full bg-gradient-to-b from-brand via-brand to-accent"></div>
    </div>
  )}
  {beam === "island" && <TimelineBeam client:visible />}
  <ol class="relative grid gap-l" role="list">
    <slot />
  </ol>
</div>
