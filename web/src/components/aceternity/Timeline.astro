---
// Aceternity UI "Timeline", split into static + island: a numbered list with a rail (static HTML,
// works with JS off), plus the scroll-filled beam as a small React island (TimelineBeam.tsx,
// client:visible). Each <li> is passed in the default slot using TimelineItem.astro.
import TimelineBeam from "./TimelineBeam.tsx";
interface Props { class?: string; beam?: boolean }
const { beam = true } = Astro.props;
---
<div class:list={["relative", Astro.props.class]}>
  <div class="absolute inset-y-0 start-[calc(1.25rem-2px)] w-1 rounded-full bg-line" aria-hidden="true"></div>
  {beam && <TimelineBeam client:visible />}
  <ol class="relative grid gap-l" role="list">
    <slot />
  </ol>
</div>
