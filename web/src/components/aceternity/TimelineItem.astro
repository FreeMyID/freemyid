---
// One step in a Timeline: number bubble on the rail, optional heading, free content.
interface Props { n: number; title?: string; id?: string }
const { n, title, id } = Astro.props;
---
<li class="reveal relative grid grid-cols-[2.5rem_1fr] gap-s" id={id}>
  <span class="relative z-10 inline-flex size-10 items-center justify-center rounded-full border-4 border-bg bg-brand text-lead font-bold text-brand-ink" aria-hidden="true">{n}</span>
  <div class="prose-fmid min-w-0 pt-3xs">
    {title && <h3>{title}</h3>}
    <slot />
  </div>
</li>
