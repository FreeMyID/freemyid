---
// Breadcrumbs (matches the BreadcrumbList JSON-LD). Revamp: shadcn-style chevron separators,
// 44px link targets.
import { url, type Crumb } from "@/lib/site";
interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---
<nav class="text-small" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-x-2xs" role="list">
    {crumbs.map(([label, out], i) => (
      <li class="flex items-center gap-2xs">
        {i > 0 && <svg aria-hidden="true" focusable="false" class="size-[1em] shrink-0 text-muted" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>}
        {i === crumbs.length - 1
          ? <span aria-current="page" class="font-semibold text-text">{label}</span>
          : <a class="inline-flex min-h-tap items-center" href={url(out)}>{label}</a>}
      </li>
    ))}
  </ol>
</nav>
