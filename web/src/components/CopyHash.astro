---
// Clipboard button for the download fingerprint, without React (replaces the CopyHash.tsx island: ~78 KiB of
// React on /download/ down to one small same-origin module). Without JavaScript the button stays hidden and the
// code above remains selectable. With JavaScript but no Clipboard API, the status line explains manual copy.
import { buttonVariants } from "./ui/button-variants";
interface Props { value: string }
const { value } = Astro.props;
---
<span class="inline-flex flex-wrap items-center gap-2" data-copy-hash={value}>
  <button type="button" class={buttonVariants({ variant: "secondary", size: "sm" })} hidden>Copy the code</button>
  <span data-copy-pending aria-hidden="true" class="text-small text-text" hidden>Copying…</span>
  <span role="status" aria-live="polite" aria-atomic="true" class="text-small text-text"></span>
</span>

<script>
  const FAILED = "Couldn't copy the code. You can select and copy the code above.";
  for (const root of document.querySelectorAll<HTMLElement>("[data-copy-hash]")) {
    const button = root.querySelector("button");
    const status = root.querySelector<HTMLElement>("[role=status]");
    const pending = root.querySelector<HTMLElement>("[data-copy-pending]");
    if (!button || !status || !pending) continue;
    if (typeof navigator.clipboard?.writeText !== "function") {
      // A closed disclosure is absent from the accessibility tree. Wait until it opens,
      // then give the already-rendered empty status a frame before adding its message.
      const showUnavailable = () => requestAnimationFrame(() => requestAnimationFrame(() => {
        status.textContent = FAILED;
      }));
      const disclosure = root.closest("details");
      if (disclosure && !disclosure.open) {
        const onToggle = () => {
          if (!disclosure.open) return;
          disclosure.removeEventListener("toggle", onToggle);
          showUnavailable();
        };
        disclosure.addEventListener("toggle", onToggle);
      } else {
        showUnavailable();
      }
      continue;
    }
    button.hidden = false;
    button.addEventListener("click", async () => {
      button.disabled = true;
      // Pending stays visible without announcing it on every activation.
      status.textContent = "";
      pending.hidden = false;
      try {
        await navigator.clipboard.writeText(root.dataset.copyHash ?? "");
        status.textContent = "Copied";
      } catch {
        status.textContent = FAILED;
      } finally {
        pending.hidden = true;
        button.disabled = false;
      }
    });
  }
</script>
