---
// Logo A (brand/logo/final), same drawing as site_src/templates/partials/brand-mark.svg.
// A/B/C test arms (docs/AB_TEST.md) draw their direction's mark instead (FreeMyID-Design-Directions logo-mark.svg):
// heritage = seal with 13 stars, frontier = stitched barn-star patch, glory = shield with stripes. Fills come from
// classes in the direction stylesheet, so the mark follows light and dark themes.
import { DIRECTION } from "@/lib/arm";
interface Props { class?: string }
const cls = ["brand-mark size-8 shrink-0", Astro.props.class];
// 13 stars on a ring (heritage seal), positions from the design file
const ring = [[32, 11], [41.76, 13.4], [49.28, 20.07], [52.85, 29.47], [51.64, 39.45], [45.93, 47.72], [37.03, 52.39],
  [26.97, 52.39], [18.07, 47.72], [12.37, 39.45], [11.15, 29.47], [14.72, 20.07], [22.24, 13.4]];
const shield = "M32 4 L56 11 V30 C56 45.5 46 55.5 32 60 C18 55.5 8 45.5 8 30 V11 Z";
// The header and footer both draw the mark, so each clipPath needs its own id. A render counter keeps the
// output deterministic (same ids on every build).
const clip = `bm-shield-${(globalThis.__fmidMarks = ((globalThis as any).__fmidMarks ?? 0) + 1)}`;
declare global { var __fmidMarks: number | undefined }
---
{DIRECTION === "heritage" ? (
  <svg class:list={cls} viewBox="0 0 64 64" width="32" height="32" aria-hidden="true" focusable="false">
    <circle cx="32" cy="32" r="31" class="bm-bg" />
    <circle cx="32" cy="32" r="27.5" fill="none" stroke-width="1.2" class="bm-gold" />
    <g class="bm-star">
      {ring.map(([x, y]) => <circle cx={x} cy={y} r="1.5" />)}
      <path d="M32 23 L34.23 28.93 L40.56 29.22 L35.61 33.17 L37.29 39.28 L32 35.8 L26.71 39.28 L28.39 33.17 L23.44 29.22 L29.77 28.93 Z" />
    </g>
    <rect x="26" y="42.2" width="12" height="2.2" rx="1.1" class="bm-bar" />
  </svg>
) : DIRECTION === "frontier" ? (
  <svg class:list={cls} viewBox="0 0 64 64" width="32" height="32" aria-hidden="true" focusable="false">
    <rect x="3" y="3" width="58" height="58" rx="13" class="bm-bg" />
    <rect x="8.5" y="8.5" width="47" height="47" rx="9" fill="none" stroke-width="1.6" stroke-dasharray="3.2 2.6" class="bm-stitch" />
    <polygon points="32,14 35.06,24.61 44.73,19.27 39.39,28.94 50,32 39.39,35.06 44.73,44.73 35.06,39.39 32,50 28.94,39.39 19.27,44.73 24.61,35.06 14,32 24.61,28.94 19.27,19.27 28.94,24.61" class="bm-star" />
    <circle cx="32" cy="32" r="3.4" class="bm-bar" />
  </svg>
) : DIRECTION === "glory" ? (
  <svg class:list={cls} viewBox="0 0 64 64" width="32" height="32" aria-hidden="true" focusable="false">
    <defs><clipPath id={clip}><path d={shield} /></clipPath></defs>
    <path d={shield} class="bm-bg" />
    <g clip-path={`url(#${clip})`}>
      <rect x="0" y="40" width="64" height="5" class="bm-bar" />
      <rect x="0" y="45" width="64" height="4" class="bm-white" />
      <rect x="0" y="49" width="64" height="5" class="bm-bar" />
    </g>
    <path d="M32 11.5l4.6 9.4 10.3 1.4-7.5 7.2 1.8 10.2-9.2-4.9-9.2 4.9 1.8-10.2-7.5-7.2 10.3-1.4z" class="bm-star" />
  </svg>
) : (
  <svg class:list={cls} viewBox="0 0 24 24" width="32" height="32" aria-hidden="true" focusable="false"><rect width="24" height="24" rx="5" class="bm-bg"/><path d="M12 2l2.9 6.6 7.1.7-5.4 4.7 1.6 7L12 17.3 5.8 21l1.6-7L2 9.3l7.1-.7z" transform="translate(4.8 4.8) scale(.6)" class="bm-star"/><rect y="20" width="24" height="2" class="bm-bar"/></svg>
)}
