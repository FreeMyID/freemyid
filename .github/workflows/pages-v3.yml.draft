# DRAFT, not active (the .draft extension keeps GitHub from running it).
# Site v3: builds web/ (Astro static output) and publishes web/dist to GitHub Pages.
# To switch over (orchestrator, after web-qa and qa-security sign off): rename to pages.yml,
# replacing the v2 workflow, in the same commit that retires site/ publishing.
# Free GitHub Pages needs a PUBLIC repository: while the repo is private the deploy job is skipped.
name: pages-v3

on:
  push:
    branches: [main]
    paths: ["web/**", "site_src/**", "brokers/registry.sample.yaml", "tools/site_check.py",
            ".github/workflows/pages.yml"]
  pull_request:
    paths: ["web/**", "site_src/**", "brokers/registry.sample.yaml", "tools/site_check.py",
            ".github/workflows/pages.yml"]
  workflow_dispatch:

permissions:
  contents: read

# Astro build telemetry off (SEC-60): astro build/dev would otherwise POST to telemetry.astro.build,
# CI included. web/package.json sets it too; the first build step fails if it is missing.
env:
  ASTRO_TELEMETRY_DISABLED: "1"

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: web
    steps:
      # Actions pinned to full commit SHAs (SEC-61). Update the SHA and the comment together.
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          persist-credentials: false
      - uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4.3.0
        with:
          version: 10.32.1
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          cache: pnpm
          cache-dependency-path: web/pnpm-lock.yaml
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: "3.12"
      - name: Astro telemetry is off (SEC-60)
        run: |
          test "${ASTRO_TELEMETRY_DISABLED:-}" = "1" || { echo "::error::ASTRO_TELEMETRY_DISABLED must be 1"; exit 1; }
          node -e 'const s=require("./package.json").scripts;const bad=Object.entries(s).filter(([,c])=>/(^|&& )astro /.test(c));if(bad.length){console.error("astro run without ASTRO_TELEMETRY_DISABLED=1:",bad.map(([k])=>k).join(", "));process.exit(1)}'
      - name: Install (exact versions from the lockfile)
        run: pnpm install --frozen-lockfile
      - name: Design tokens are up to date (contrast pairs checked)
        run: node scripts/gen-tokens.mjs --check
      - name: Build (astro build + per-page CSP tightening)
        run: pnpm build
      - name: Check (meta, CSP, links, anchors, images, sitemap, budgets)
        run: pnpm check
      - name: Copy rules and leak scan (tools/site_check.py)
        run: python scripts/content_check.py dist
      - uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa # v3.0.1
        with:
          path: web/dist

  deploy:
    needs: build
    if: ${{ github.event_name != 'pull_request' && !github.event.repository.private }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e # v4.0.5
